{
  "info": {
    "_postman_id": "9a44994e-6485-4d55-bbf4-06f28e19f7c5",
    "name": "Snackday Local",
    "description": "Local Snackday web and scaffold API requests. Start normally with `bun run --filter web dev`; development identity requests require `SNACKDAY_DEV_SIGN_IN=true`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "teamId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Pages",
      "item": [
        {
          "name": "Marketing home",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Features",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/features"
          }
        },
        {
          "name": "App shell",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/app"
          }
        }
      ]
    },
    {
      "name": "Scaffold API",
      "description": "Temporary scaffold endpoints; these will be replaced by Snackday domain APIs.",
      "item": [
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts"
          }
        }
      ]
    },
    {
      "name": "Development identity",
      "description": "Local-only adult Account sign-in. Start the server with SNACKDAY_DEV_SIGN_IN=true. Postman carries the HttpOnly cookie in its cookie jar; no token is copied into variables or scripts.",
      "item": [
        {
          "name": "Sign in fixed adult",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Sec-Fetch-Site",
                "value": "same-origin",
                "description": "Required by the local origin-check CSRF guard."
              }
            ],
            "url": "{{baseUrl}}/api/dev/sign-in"
          }
        },
        {
          "name": "Check authenticated session",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dev/session"
          }
        }
      ]
    },
    {
      "name": "Teams",
      "description": "Authenticated team and season requests. Run the development sign-in first; Postman's cookie jar carries the HttpOnly session.",
      "item": [
        {
          "name": "Create team",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('teamId', body.team.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Sec-Fetch-Site",
                "value": "same-origin"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"T-Ball Tigers\"\n}"
            },
            "url": "{{baseUrl}}/api/teams"
          }
        },
        {
          "name": "Create season",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Sec-Fetch-Site",
                "value": "same-origin"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Spring 2026\",\n  \"startDate\": \"2026-03-01\",\n  \"endDate\": \"2026-06-01\",\n  \"timeZone\": \"America/Los_Angeles\"\n}"
            },
            "url": "{{baseUrl}}/api/teams/{{teamId}}/seasons"
          }
        },
        {
          "name": "Read team",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/teams/{{teamId}}"
          }
        }
      ]
    }
  ]
}
