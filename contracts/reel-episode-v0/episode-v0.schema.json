{
  "$id": "https://reel.dimasc.io/contracts/episode-v0.schema.json",
  "title": "reel.episode/v0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "reel.episode/v0"
    },
    "series": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "site": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "title",
        "site"
      ],
      "additionalProperties": false
    },
    "episode": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string"
        },
        "blurb": {
          "type": "string"
        },
        "ages": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 18
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "version": {
          "type": "string",
          "pattern": "^v\\d+$"
        },
        "page": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "slug",
        "number",
        "title",
        "blurb",
        "ages",
        "version",
        "page"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "video": {
          "type": "string",
          "format": "uri"
        },
        "poster": {
          "type": "string",
          "format": "uri"
        },
        "captions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lang": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "lang",
              "label",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "video",
        "poster",
        "captions",
        "seconds"
      ],
      "additionalProperties": false
    },
    "skills": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "quiz": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "minItems": 2,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "feedback": {
            "type": "object",
            "properties": {
              "correct": {
                "type": "string",
                "minLength": 1
              },
              "wrong": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "correct",
              "wrong"
            ],
            "additionalProperties": false
          },
          "skill": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "required": [
          "id",
          "prompt",
          "choices",
          "answer",
          "feedback",
          "skill"
        ],
        "additionalProperties": false
      }
    },
    "transcript": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "who",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schema",
    "series",
    "episode",
    "media",
    "skills",
    "quiz",
    "transcript",
    "publishedAt"
  ],
  "additionalProperties": false
}
