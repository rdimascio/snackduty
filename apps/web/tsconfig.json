{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./app/*"]
    }
  },
  "include": ["env.ts", "lesto.app.ts", "lesto.sites.ts", "worker.ts", "app", "runtime"]
}
