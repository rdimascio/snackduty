{
  "name": "snackday",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "ios:build": "bash scripts/ios-build.sh",
    "ios:test": "bash scripts/ios-test.sh",
    "ios:verify": "bash scripts/ios-verify.sh",
    "test": "bun run --filter '*' test",
    "gate": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "oxfmt": "^0.54.0",
    "oxlint": "1.73.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "packageManager": "yarn@1.22.22"
}
